{
  "name": "closebench",
  "version": "0.1.0",
  "description": "The reference benchmark for AI sales agents — end-to-end, tool-using, compliance-gated.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/AndreuwMetal/closebench",
  "repository": { "type": "git", "url": "https://github.com/AndreuwMetal/closebench.git" },
  "keywords": ["benchmark", "llm", "agents", "sales", "evaluation", "leaderboard", "tau-bench"],
  "scripts": {
    "bench": "node closebench.ts",
    "bench:dry": "node closebench.ts --dry --concurrencia 2",
    "bench:dry:http": "node closebench.ts --dry --protocol http --concurrencia 2",
    "bench:dry:python": "SUT_CMD='python3 adapters/http_agent.py' node closebench.ts --dry --protocol http --concurrencia 2",
    "bench:dry:saas": "node closebench.ts --dry --domain saas --concurrencia 2",
    "bench:dry:all": "npm run bench:dry && npm run bench:dry:http && npm run bench:dry:python && npm run bench:dry:saas",
    "bench:http": "node closebench.ts --protocol http",
    "bench:opus": "node closebench.ts --brain opus",
    "bench:bad": "node closebench.ts --prompt prompts/bad.md --solo redteam,regateo,objeciones",
    "kappa": "node kappa.ts",
    "submit:validate": "node submission.ts validate",
    "verify:submission": "node submission.ts verify",
    "hidden:seal": "node submission.ts seal-hidden",
    "leaderboard": "node leaderboard.ts",
    "test:stage3": "node submission.ts selftest",
    "negotiation": "node negotiation.ts",
    "negotiation:dry": "node negotiation.ts --dry"
  },
  "engines": { "node": ">=24" }
}
