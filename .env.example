# CloseBench — copy to .env for REAL runs. Dry runs (`npm run bench:dry`) need NOTHING here.
#
# Judge (Opus 4.8) + simulated buyer (Sonnet 5) — Anthropic native API. Required for real runs.
ANTHROPIC_API_KEY=

# Brain of the bundled reference agent (an OpenAI-compatible model). Default is GLM-5.2 via Z.ai.
ZAI_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# `npm run bench:opus`: swaps the agent's brain for Opus via OpenRouter (rival baseline).
OPENROUTER_API_KEY=

# Optional overrides for the eval models:
# JUDGE_MODEL=claude-opus-4-8
# BUYER_MODEL=claude-sonnet-5

# ── Bring your own agent ────────────────────────────────────────────────────
# By default CloseBench benchmarks the bundled reference agent (adapters/reference-agent.ts).
# To benchmark YOUR agent instead, point SUT_CMD at a command that starts it (see docs/ADAPTERS.md).
# It must honor the same env contract (PORT, WEBHOOK_TOKEN, KAPSO_BASE_URL, STRIPE_BASE_URL, DB_PATH, ...).
# SUT_CMD=node /path/to/your/agent.ts
