# Secrets
.env
.env.local
*.key

# Generated benchmark output (regenerable) — the harness writes here.
# Committed example results are force-added; everything else is ignored.
results/*
!results/.gitkeep
!results/EXAMPLE-*.md
# Published evidence: the runs the docs cite, so a claim can be read and not just re-run.
# PUBLIC SPLIT ONLY — a hidden-split report carries its transcripts, and publishing those
# would leak the very set the official score depends on. Hidden runs stay on maintainer machines.
!results/published/

# Hidden split — NEVER committed: the official score runs on it, and publishing it would turn
# generalization into memorization. Only its commitment (scenarios-hidden.sha256) is public.
# Maintainers keep a private backup OUTSIDE any public repo; a leak forces a refresh + version bump.
scenarios-hidden/
_backups-scenarios/

# Local agent DB / logs
*.db
*.log

# Deps / OS
node_modules/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Per-domain hidden splits (Stage 4): same rule as the root one — never committed, only a commitment.
domains/*/scenarios-hidden/

# Session scratch (subagent-driven-development ledger)
.superpowers/
